APP_ENV=development
DATABASE_URL=postgresql+psycopg://vera:vera_local_only@localhost:5432/vera
POSTGRES_USER=vera
POSTGRES_PASSWORD=vera_local_only
POSTGRES_DB=vera
ALLOWED_ORIGINS=["http://localhost:5173"]
COOKIE_SECURE=false
SESSION_HOURS=8
DEMO_ENABLED=true
DEMO_PASSWORD=Vera-Ficticia-2026!
# Factoría del almacenamiento privado; no debe generar URLs públicas.
STORAGE_FACTORY=app.storage:LocalStorage
STORAGE_ROOT=.private-storage
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=25000000
MAX_PDF_PAGES=200
# Respuesta preparada (demo_fixture.json) sin modelo ni llamadas externas.
# Siempre hay respaldo: adaptador configurado -> demo_fixture.json -> selección extractiva.
TIMELINE_AI_FACTORY=app.timeline_ai:FixtureAdapter
# IA real vía OpenRouter (misma cuenta y endpoint que CHAT_BRAIN=openrouter, ver más abajo):
# TIMELINE_AI_FACTORY=app.timeline_ai:OpenRouterTimelineAdapter
# Para un servicio propio que implemente el contrato documentado (contrato "selected_ids" o events/review_items): app.timeline_ai:HttpAdapter
TIMELINE_AI_URL=
TIMELINE_AI_KEY=
# Modelo de OpenRouter para OpenRouterTimelineAdapter; vacío = usa CHAT_MODEL (misma cuenta, mismos
# CHAT_FALLBACK_MODELS/timeout/enrutamiento de proveedor que el chat).
TIMELINE_MODEL=
# Cerebro de la conversación (epic #5): "scripted" (respaldo guionado, sin proveedor externo) o "openrouter"
# (IA real vía OpenRouter, API compatible con OpenAI Chat Completions, un solo Bearer key para muchos
# proveedores/modelos). Con CHAT_BRAIN=openrouter, cada mensaje del chat viaja a OpenRouter y al proveedor del
# modelo elegido (OPENROUTER_API_KEY obligatoria); sin clave o ante cualquier error del proveedor, el turno
# responde en mode "demo" con ScriptedBrain en su lugar, nunca con un error 5xx.
CHAT_BRAIN=scripted
OPENROUTER_API_KEY=
# Modelo primario y, si no está disponible, la lista de reemplazo que OpenRouter intenta en orden (su propio
# parámetro `models`). Ambos verificados el 2026-09-26 en el listado público de OpenRouter con soporte de
# `tools` + `structured_outputs`.
CHAT_MODEL=google/gemini-3.1-flash-lite
CHAT_FALLBACK_MODELS=["deepseek/deepseek-v4-flash"]
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT_SECONDS=30
# Opcionales, solo para las páginas de ranking de apps de OpenRouter; nunca requeridos.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=
